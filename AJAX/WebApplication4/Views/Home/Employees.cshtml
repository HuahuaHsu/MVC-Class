		$('#postEmployee').on('click',async()=>{
			// alert('postEmployee');
			var emp ={
				EmployeeId:0,
				FirstName:"Axios",
				LastName:"POST",
				Title:"Student"
			}
			try{
				var response = await axios.post(`${baseAddress}/api/Employees`,JSON.stringify(emp),{
					headers:{
						"content-type":"application/json"
					}
				});
				if(response.data.ok){
					alert("新增員工紀錄成功");
				}else{
					alert("新增員工紀錄失敗");
				};
			}catch(err){
				alert(err.message);
			}
		});

		$('#putEmployee').on('click',async()=>{
			// alert('putEmployee');
			var employeeId = $("#employeeId").val();
			var emp ={
				EmployeeId:employeeId,
				FirstName:"Fuen",
				LastName:"2026",
				Title:"CEO"
			};
			try{
				var response = await fetch(`${baseAddress}/api/Employees/${employeeId}`,{
					method:'Put',
					body:JSON.stringify(emp),
					headers:{
						"content-type":"Application/json"
					}
				});
				if(response.ok){
					var data = await response.json();
					// alert(Json.stringfy(data));
					if(data.ok){
						alert("修改員工紀錄成功");
					}else{
						alert("修改員工紀錄失敗");
					}
				}
			}catch(err){
				alert(err.message);
			}
		});

		$('#deleteEmployee').on('click',async()=>{
			// alert('deleteEmployee');
			try{
				var response = await fetch(`${baseAddress}/api/Employees/${$('#employeeId').val()}`,{
					method:"delete"
				});
				if(response.ok){
					var data = await response.json();
					if(data.ok){
						alert("刪除員工紀錄成功");
					}else{
						alert("刪除員工紀錄失敗");
					}
				}
			}catch(err)
