<button id="getEmployeeById" class="btn btn-primary">getEmployeeById</button>
<input id="employeeId" />
<button id="postEmployee" class="btn btn-primary">PostEmployee</button>
<button id="putEmployee" class="btn btn-warning">PutEmployee</button>
<button id="deleteEmployee" class="btn btn-danger">deleteEmployee</button>

@section Scripts{
	<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js" integrity="sha512-h9644v03pHqrIHThkvXhB2PJ8zf5E9IyVnrSfZg8Yj8k4RsO4zldcQc4Bi9iVLUCCsqNY0b4WXVV4UB+wbWENA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
