@model WebApplication3.Models.EfModels.Product

@{
    ViewData["Title"] = "Edit";
}

<h1>編輯</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-2">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                    <option value=""></option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label asp-for="SupplierId" class="control-label"></label>
                <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId"></select>
                <span asp-validation-for="SupplierId" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label asp-for="ProductName" class="control-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label asp-for="OrigPrice" class="control-label"></label>
                <input asp-for="OrigPrice" class="form-control" />
                <span asp-validation-for="OrigPrice" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <label asp-for="UnitPrice" class="control-label"></label>
                <input asp-for="UnitPrice" class="form-control" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>
            <div class="mb-2">
                <input type="submit" value="Save" class="btn btn-primary" />
				<a asp-action="Index" class="btn btn-dark">Back to List</a>
			</div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
