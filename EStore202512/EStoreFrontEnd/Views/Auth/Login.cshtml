@model EStoreFrontEnd.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";

	string? returnUrl =Context.Request.Query["returnUrl"].ToString();
    if(string.IsNullOrEmpty(returnUrl))
    {
		returnUrl = Url.Action("Index", "Members");//如果没有指定返回URL，则默认返回会员中心首页
	}
}

<h1>Login</h1>

<h4>LoginViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Login">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Account" class="control-label"></label>
                <input asp-for="Account" class="form-control" />
                <span asp-validation-for="Account" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <input type="submit" value="登入" class="btn btn-primary" />
                <a href="/Members/ForgetPassword" class="btn btn-danger">忘記密碼</a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
