@model IEnumerable<WebApplication2.Models.EfModels.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>產品列表</h1>

<p>
    <a asp-action="Create" class="btn btn-sm btn-primary">新增</a>
</p>
<form asp-action="Index" method="get">
    <div class="row mb-3 align-items-center">
        <div class="col-auto">
            <label class="col-form-label fw-bold">依分類篩選：</label>
        </div>
        <div class="col-auto">
            <select name="categoryId" class="form-select" asp-items="ViewBag.CategoryId" onchange="this.form.submit()">
                <option value="">-- 所有分類 --</option>
            </select>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">清除篩選</a>
        </div>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrigPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Supplier)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrigPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnitPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Supplier.CompanyName)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-danger">編輯</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-dark">刪除</a>
            </td>
        </tr>
}
    </tbody>
</table>
